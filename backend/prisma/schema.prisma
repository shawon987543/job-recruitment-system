
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  CANDIDATE
}

enum CompanyStatus {
  PENDING
  APPROVED
  REJECTED
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ApplicationStatus {
  PENDING
  SHORTLISTED
  REJECTED
  INTERVIEW_SCHEDULED
  SELECTED
  WITHDRAWN
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum EmailType {
  ADMIN_CREDENTIALS
  APPLICATION_UPDATE
  INTERVIEW_INVITATION
  GENERAL
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id                 Int      @id @default(autoincrement())
  name               String
  email              String   @unique
  password           String
  role               Role     @default(CANDIDATE)
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  refreshTokenHash   String?
  companyId          Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company             Company? @relation("CompanyMembers", fields: [companyId], references: [id], onDelete: Restrict)
  requestedCompanies  Company[] @relation("CompanyRequester")
  approvedCompanies   Company[] @relation("CompanyApprover")
  profile             CandidateProfile?
  applications        Application[]
  jobsCreated         Job[]     @relation("JobCreator")
  interviewsScheduled Interview[] @relation("InterviewScheduler")
  emailLogs           EmailLog[]

  @@index([role, isActive])
  @@index([companyId])
}

model Company {
  id                 Int           @id @default(autoincrement())
  name               String
  email              String
  phone              String?
  website            String?
  address            String?
  industry           String?
  description        String?       @db.Text
  registrationNumber String?       @unique
  status             CompanyStatus @default(PENDING)
  isActive           Boolean       @default(true)
  rejectionReason    String?       @db.Text
  requestedById      Int?
  approvedById       Int?
  approvedAt         DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  requestedBy User? @relation("CompanyRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedBy  User? @relation("CompanyApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  members     User[] @relation("CompanyMembers")
  jobs        Job[]

  @@index([status, isActive])
  @@index([name])
}

model CandidateProfile {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  phone        String?
  address      String?
  headline     String?
  summary      String?  @db.Text
  skills       String[] @default([])
  linkedinUrl  String?
  portfolioUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  educations  Education[]
  experiences Experience[]
}

model Education {
  id           Int      @id @default(autoincrement())
  profileId    Int
  institution  String
  degree       String?
  fieldOfStudy String?
  startDate    DateTime?
  endDate      DateTime?
  description  String?  @db.Text
  createdAt    DateTime @default(now())

  profile CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Experience {
  id          Int      @id @default(autoincrement())
  profileId   Int
  companyName String
  position    String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean  @default(false)
  description String?  @db.Text
  createdAt   DateTime @default(now())

  profile CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Job {
  id               Int       @id @default(autoincrement())
  companyId        Int
  createdById      Int
  title            String
  description      String    @db.Text
  requirements     String?   @db.Text
  responsibilities String?   @db.Text
  employmentType   JobType   @default(FULL_TIME)
  location         String?
  isRemote         Boolean   @default(false)
  salaryMin        Decimal?  @db.Decimal(12, 2)
  salaryMax        Decimal?  @db.Decimal(12, 2)
  salaryCurrency   String    @default("BDT")
  status           JobStatus @default(DRAFT)
  deadline         DateTime?
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy    User          @relation("JobCreator", fields: [createdById], references: [id], onDelete: Restrict)
  applications Application[]

  @@index([companyId, status])
  @@index([status, deadline])
  @@index([title])
  @@index([location])
}

model Application {
  id          Int               @id @default(autoincrement())
  candidateId Int
  jobId       Int
  coverLetter String?           @db.Text
  cvUrl       String
  status      ApplicationStatus @default(PENDING)
  appliedAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  withdrawnAt DateTime?

  candidate User        @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  job       Job         @relation(fields: [jobId], references: [id], onDelete: Restrict)
  interviews Interview[]

  @@unique([candidateId, jobId])
  @@index([jobId, status])
  @@index([candidateId, appliedAt])
}

model Interview {
  id              Int             @id @default(autoincrement())
  applicationId   Int
  scheduledById   Int
  scheduledAt     DateTime
  durationMinutes Int             @default(30)
  location        String?
  meetingUrl      String?
  notes           String?         @db.Text
  feedback        String?         @db.Text
  status          InterviewStatus @default(SCHEDULED)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  scheduledBy User        @relation("InterviewScheduler", fields: [scheduledById], references: [id], onDelete: Restrict)

  @@index([applicationId, scheduledAt])
}

model EmailLog {
  id        Int         @id @default(autoincrement())
  userId    Int?
  recipient String
  subject   String
  type      EmailType
  status    EmailStatus @default(PENDING)
  error     String?     @db.Text
  sentAt    DateTime?
  createdAt DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([recipient])
}
